{
  "name": "anafor-mcp",
  "version": "0.9.0",
  "description": "Frontier yapay zekâ modelleri için orkestrasyon MCP sunucusu",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "anafor": "dist/cli/main.js",
    "anafor-mcp": "dist/server/main.js",
    "anafor-runner": "dist/runner/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frudotz/anafor-mcp.git"
  },
  "files": [
    "dist",
    "docs/agent-install.md",
    "llms.txt",
    "schemas",
    "scripts",
    "plugin"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
